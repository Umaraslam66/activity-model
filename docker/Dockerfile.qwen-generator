FROM nvidia/cuda:12.2.2-devel-ubuntu22.04

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
ARG TORCH_VERSION=2.5.0
ARG TORCHVISION_VERSION=0.20.0
ARG TORCHAUDIO_VERSION=2.5.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/cache/huggingface \
    TRANSFORMERS_CACHE=/cache/huggingface \
    PROJECT_ROOT=/workspace \
    OUTPUT_ROOT=/workspace/data/container-smoke \
    TOKENIZERS_PARALLELISM=false \
    CUDA_HOME=/usr/local/cuda

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-venv && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirements_inference.txt requirements_smoke.txt ./

RUN python3 -m pip install --upgrade pip setuptools wheel

RUN python3 -m pip install \
    --index-url "${TORCH_INDEX_URL}" \
    "torch==${TORCH_VERSION}" \
    "torchvision==${TORCHVISION_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}"

RUN python3 -m pip install -r requirements_inference.txt -r requirements_smoke.txt

RUN python3 -c "from transformers import AutoProcessor, Gemma4ForConditionalGeneration; print(AutoProcessor.__name__); print(Gemma4ForConditionalGeneration.__name__); print('gemma4_transformers_impl_ok')"

RUN python3 -c "import sys, accelerate, torch, transformers; print(f'python={sys.version.split()[0]}'); print(f'torch={torch.__version__}'); print(f'transformers={transformers.__version__}'); print(f'accelerate={accelerate.__version__}'); print('torch_index_url=${TORCH_INDEX_URL}')" > /etc/bonzai-build-manifest.txt

COPY . /workspace

ENTRYPOINT ["python3"]
CMD ["scripts/generate_activity_chains_qwen.py"]
