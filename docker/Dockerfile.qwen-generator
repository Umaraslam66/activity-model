FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/cache/huggingface \
    TRANSFORMERS_CACHE=/cache/huggingface \
    VLLM_CACHE_ROOT=/cache/vllm \
    PROJECT_ROOT=/workspace \
    OUTPUT_ROOT=/workspace/data/container-smoke \
    TOKENIZERS_PARALLELISM=false \
    CUDA_HOME=/usr/local/cuda

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-venv \
      python3-dev \
      git \
      gcc \
      g++ && \
    rm -rf /var/lib/apt/lists/* && \
    ln -s /usr/local/cuda/targets/x86_64-linux/lib/stubs/libcuda.so \
          /usr/lib/x86_64-linux-gnu/libcuda.so.1

WORKDIR /workspace

COPY requirements_inference.txt requirements_smoke.txt ./

# Install vLLM, then pin transformers to a Gemma-4-capable release.
RUN python3 -m pip install --upgrade pip setuptools wheel && \
    python3 -m pip install -r requirements_inference.txt -r requirements_smoke.txt && \
    python3 -m pip install --no-deps "transformers==5.5.0" "huggingface_hub==1.7.2" "accelerate==1.13.0" && \
    python3 -c "from importlib import import_module; module = import_module('vllm.model_executor.models.gemma4'); assert hasattr(module, 'Gemma4ForConditionalGeneration'), 'Gemma4 vLLM implementation missing'; print('gemma4_vllm_impl_ok')" && \
    python3 -c "import sys, torch, transformers, vllm; print(f'python={sys.version.split()[0]}'); print(f'torch={torch.__version__}'); print(f'transformers={transformers.__version__}'); print(f'vllm={vllm.__version__}')" > /etc/bonzai-build-manifest.txt

COPY . /workspace

ENTRYPOINT ["python3"]
CMD ["scripts/generate_activity_chains_qwen.py"]
