FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/cache/huggingface \
    TRANSFORMERS_CACHE=/cache/huggingface \
    VLLM_CACHE_ROOT=/cache/vllm \
    PROJECT_ROOT=/workspace \
    OUTPUT_ROOT=/workspace/data/container-smoke \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-venv \
      git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirements_inference.txt requirements_smoke.txt ./

RUN python3 -m pip install --upgrade pip setuptools wheel && \
    python3 -m pip install -r requirements_inference.txt -r requirements_smoke.txt

COPY . /workspace

ENTRYPOINT ["python3"]
CMD ["scripts/generate_activity_chains_qwen.py"]
