FROM vllm/vllm-openai:v0.18.0

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/cache/huggingface \
    TRANSFORMERS_CACHE=/cache/huggingface \
    VLLM_CACHE_ROOT=/cache/vllm \
    PROJECT_ROOT=/workspace \
    OUTPUT_ROOT=/workspace/data/container-smoke \
    TOKENIZERS_PARALLELISM=false

WORKDIR /workspace

COPY requirements_inference.txt requirements_smoke.txt ./

# vllm base image already has vllm, torch, triton, gcc, CUDA all configured.
# Just upgrade transformers for Qwen3.5 support and install our extra deps.
RUN pip install --no-deps "transformers==5.3.0" "huggingface_hub==1.7.2" "accelerate==1.13.0" && \
    pip install jsonschema==4.26.0 hf_transfer==0.1.9 pytest>=8.3.0

COPY . /workspace

ENTRYPOINT ["python3"]
CMD ["scripts/generate_activity_chains_qwen.py"]
